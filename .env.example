# Actual .env is generated on first gateway start; never copy a real token into reports.
GATEWAY_TOKEN=replace-with-a-random-local-token
GATEWAY_URL=http://127.0.0.1:8001
# Empty by default. Exact comma-separated origins, no trailing slash, no wildcard.
# ALLOWED_ORIGINS=chrome-extension://YOUR_EXTENSION_ID,http://localhost:3210
ALLOWED_ORIGINS=
# Optional existing executable path, useful when launched outside Hermes's PATH:
# FFMPEG_PATH=C:/path/to/ffmpeg.exe
