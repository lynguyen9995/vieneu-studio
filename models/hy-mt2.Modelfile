# Hy-MT2-1.8B (Tencent, Apache-2.0) for Ollama with a corrected chat template.
# The template auto-converted by Ollama from the GGUF drops the prompt, so the model
# prints garbage. This rebuilds the original Jinja template (tokenizer.chat_template):
#   <bos>[system<no3>] <User>text <Assistant>
# Sampling = Tencent's recommendation for 1.8B/7B (temp 0.7, top_p 0.6, top_k 20, rep 1.05).
# Create:  ollama create hy-mt2 -f models\hy-mt2.Modelfile   (reuses the downloaded weights)
FROM hf.co/tencent/Hy-MT2-1.8B-GGUF
TEMPLATE """{{- if .System }}<｜hy_begin▁of▁sentence｜>{{ .System }}<｜hy_place▁holder▁no▁3｜>{{- else }}<｜hy_begin▁of▁sentence｜>{{- end }}{{- range .Messages }}{{- if eq .Role "user" }}<｜hy_User｜>{{ .Content }}{{- else if eq .Role "assistant" }}<｜hy_Assistant｜>{{ .Content }}<｜hy_place▁holder▁no▁2｜>{{- end }}{{- end }}<｜hy_Assistant｜>"""
PARAMETER stop "<｜hy_place▁holder▁no▁2｜>"
PARAMETER stop "<｜hy_place▁holder▁no▁8｜>"
PARAMETER stop "<｜hy_User｜>"
PARAMETER temperature 0.7
PARAMETER top_p 0.6
PARAMETER top_k 20
PARAMETER repeat_penalty 1.05
PARAMETER num_ctx 4096
